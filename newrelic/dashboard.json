{
  "name": "GEX levels job",
  "description": "GitHub Action kostyanius/gex-levels: GEX calculation every 5 minutes",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "GEX levels job",
      "widgets": [
        {
          "title": "Last run",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT latest(instrumentsOk) AS 'Instruments OK', latest(instrumentsTotal) AS 'Total', latest(durationSec) AS 'Duration, s' FROM GexJob SINCE 1 hour ago"
              }
            ]
          }
        },
        {
          "title": "Runs in the last 30 min (expected ~6)",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT count(*) AS 'Runs' FROM GexJob SINCE 30 minutes ago"
              }
            ]
          }
        },
        {
          "title": "Failed instruments, 24h",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT count(*) AS 'Errors' FROM GexRun WHERE ok = 0 SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "Instruments now",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT latest(status) AS 'Status', latest(levels) AS 'Levels', latest(spot) AS 'Spot', latest(durationSec) AS 'Duration, s', latest(error) AS 'Error' FROM GexRun FACET instrument SINCE 1 hour ago"
              }
            ]
          }
        },
        {
          "title": "Runs by status",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT count(*) FROM GexRun FACET status TIMESERIES AUTO SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "Download + calculation time by instrument",
          "layout": {
            "column": 7,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT average(durationSec) FROM GexRun FACET instrument TIMESERIES AUTO SINCE 1 day ago"
              }
            ]
          }
        },
        {
          "title": "Errors",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT timestamp, instrument, source, error FROM GexRun WHERE ok = 0 SINCE 1 week ago LIMIT 100"
              }
            ]
          }
        },
        {
          "title": "Job runs (links to GitHub)",
          "layout": {
            "column": 1,
            "row": 13,
            "width": 12,
            "height": 3
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  8614199
                ],
                "query": "SELECT timestamp, ok, instrumentsOk, durationSec, trigger, runUrl FROM GexJob SINCE 1 day ago LIMIT 50"
              }
            ]
          }
        }
      ]
    }
  ]
}